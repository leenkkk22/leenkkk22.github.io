---
import { site } from '../data/portfolio';

const year = new Date().getFullYear();
---

<footer class="border-t border-surface-border/60 py-8">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-6 text-sm text-gray-500 md:flex-row">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <p class="font-mono text-xs">Built with Astro + Tailwind CSS</p>
  </div>
</footer>
