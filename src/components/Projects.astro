---
import { projects } from '../data/portfolio';
---

<section id="projects" class="section-container border-t border-surface-border/40">
  <h2 class="section-title">Projects</h2>
  <div class="grid gap-6 md:grid-cols-2">
    {projects.map((project) => (
      <article class="card flex flex-col">
        <div class="mb-3 flex items-start justify-between gap-3">
          <h3 class="text-lg font-semibold text-white">{project.title}</h3>
          {project.highlight && (
            <span class="shrink-0 rounded-full bg-accent-muted px-2.5 py-0.5 text-xs text-accent">
              {project.highlight}
            </span>
          )}
        </div>
        <p class="mb-4 flex-1 text-sm leading-relaxed text-gray-400">
          {project.description}
        </p>
        <ul class="mb-5 flex flex-wrap gap-2">
          {project.techStack.map((tech) => (
            <li class="font-mono text-xs text-gray-500">{tech}</li>
          ))}
        </ul>
        <div class="flex gap-3">
          {project.githubUrl && (
            <a
              href={project.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-accent transition-colors hover:text-accent-hover"
            >
              GitHub →
            </a>
          )}
          {project.demoUrl && (
            <a
              href={project.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-gray-400 transition-colors hover:text-white"
            >
              Live Demo →
            </a>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
