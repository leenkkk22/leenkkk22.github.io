---
import { site } from '../data/portfolio';
---

<section class="section-container flex min-h-[85vh] flex-col justify-center pt-8">
  <p class="mb-4 font-mono text-sm text-accent">안녕하세요, 저는 사용자 친화적이고 안정성 높은 서비스를 만들고 싶은</p>
  <h1 class="mb-4 text-4xl font-bold tracking-tight text-white md:text-6xl">
    {site.name}
  </h1>
  <p class="mb-6 max-w-xl text-xl text-gray-400 md:text-2xl">
    {site.title}
  </p>
  <p class="mb-10 max-w-lg text-base leading-relaxed text-gray-500">
    {site.description}
  </p>

  <div class="flex flex-wrap gap-4">
    <a href="#projects" class="btn-primary">
      프로젝트 보기
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
    <a href="#contact" class="btn-outline">연락하기</a>
    {
      site.resumeUrl && (
        <a href={site.resumeUrl} target="_blank" rel="noopener noreferrer" class="btn-outline">
          이력서
        </a>
      )
    }
  </div>
</section>
