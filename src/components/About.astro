---
import { about } from '../data/portfolio';
---

<section id="about" class="section-container border-t border-surface-border/40">
  <h2 class="section-title">About</h2>
  <div class="max-w-2xl space-y-4 text-base leading-relaxed text-gray-400">
    {about.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>
</section>
